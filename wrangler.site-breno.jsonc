// Endereço antigo (site-breno.brenoandreati.workers.dev): o mesmo app e as mesmas contas,
// com um aviso do endereço novo. Para publicar: npx wrangler deploy -c wrangler.site-breno.jsonc
{
  "name": "site-breno",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "publico",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenda",
      "database_id": "c0e54ecd-990f-41ba-89eb-065fee07fd62",
      "migrations_dir": "migrations"
    }
  ],
  // Sem lembretes aqui: quem manda é o agenda-arvan (senão chegariam em dobro)
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
