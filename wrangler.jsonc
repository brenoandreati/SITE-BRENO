// Publicação no Cloudflare: o app (arquivos estáticos) + o servidor das contas (worker/)
// + o banco D1 "agenda". Para publicar: npm run publicar
{
  "name": "site-breno",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "publico",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenda",
      "database_id": "c0e54ecd-990f-41ba-89eb-065fee07fd62",
      "migrations_dir": "migrations"
    }
  ],
  // A cada 5 minutos: lembretes no WhatsApp
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
